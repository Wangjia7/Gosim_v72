+    @staticmethod
+    def joint_completion_lower_bound(probabilities, required):
+        """Dependence-free bound conditional on supplied model marginals.
+
+        E[N_j] <= (k-1)+(j-k+1)*P(N_j>=k), for any chosen j targets.
+        These marginals are estimates, so this is a heuristic, not official truth.
+        """
+        if required <= 0:
+            return 1.0
+        values = sorted((min(1.0,max(0.0,float(p))) if math.isfinite(float(p)) else 0.0
+                         for p in probabilities), reverse=True)
+        if len(values) < required:
+            return 0.0
+        total = 0.0
+        bound = 0.0
+        for j,p in enumerate(values,1):
+            total += p
+            if j >= required:
+                bound = max(bound,(total-(required-1))/(j-required+1))
+        return min(1.0,max(0.0,bound))
