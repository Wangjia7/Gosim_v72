+def safe_error_metadata(exc):
+    """Bounded traceback locations only; never inspect messages, arguments or locals."""
+    frames = []
+    tb = exc.__traceback__
+    while tb is not None:
+        code = tb.tb_frame.f_code
+        frames.append({"file": os.path.basename(code.co_filename),
+                       "function": code.co_name, "line": tb.tb_lineno})
+        if len(frames) > 8:
+            del frames[0]
+        tb = tb.tb_next
+    return {"class": type(exc).__name__, "frames": frames}
