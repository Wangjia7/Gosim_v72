# Optional local configuration. Never pack or commit .env or credentials.
# No credentials are required: missing keys select rules-only mode.
# Force no-model behavior even if an advisory key is configured:
OBSERVER_MODEL_DISABLED=1

# Existing night/fault advisor; blank values retain inherited endpoint/model defaults.
# OPENAI_API_KEY is optional; KIMI_API_KEY is an alternate advisory credential.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# Retrospective CLI ONLY, explicitly enabled with --remote; no provider defaults.
PRO_REVIEW_BASE_URL=
PRO_REVIEW_MODEL=
PRO_REVIEW_API_KEY=

# Process CPU seconds reserved; the official900 budget uses normalized CPU seconds.
PRO_CPU_RESERVE=2.0
PRO_FIXED_LEVEL=-1
PRO_LOG_PATH=decision-log.jsonl
# Optimization defaults remain subject to paired evaluation. See README before overrides.
# PRO_GEOMETRY=1
# PRO_STATE_EVIDENCE=1
# PRO_TEMPORAL=1
# PRO_PROGRAM_AWARE=1
# PRO_EVENT_DURATIONS=1
# PRO_GAIN_CACHE=1
