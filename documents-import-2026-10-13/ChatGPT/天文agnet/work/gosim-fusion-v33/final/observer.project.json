{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "python:3.12-bookworm",
  "build": [
    [
      "python3",
      "build_native.py"
    ]
  ],
  "run": [
    "python3",
    "-u",
    "agent.py"
  ],
  "working_directory": ".",
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PRO_FULL_FIELD": "0",
    "PRO_BREAKPOINTS": "0",
    "PRO_CONSERVATIVE_REQUIRED": "0",
    "PRO_REQUEST_BATCH": "0",
    "FUSION_QUAKE_CURVE": "0",
    "FUSION_JOINT_PROGRAM": "1"
  }
}
